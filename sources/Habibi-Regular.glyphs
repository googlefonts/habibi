{
key = descriptions;
values = (
{
language = ENG;
value = "Habibi is a high contrast serifed text face. Habibi is easy to read and offers a certain elegance to go with this. Habibi draws both on the qualities of 15th and 16th century text faces and on crisp conteporary ones. Habibi can be used from small sizes to larger display settings.";
}
);
